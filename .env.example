# Runtime
APP_ENV=development
DATA_MODE=live
HOST=127.0.0.1
PORT=8080
DB_PATH=data/floodops.sqlite3

# Public data sources
NWS_USER_AGENT="AustinFloodOps/0.1 contact@example.com"
USGS_SITE_ID=08158000
USGS_PARAMETER_CODES=00060,00065
POLL_SECONDS=30
HEARTBEAT_ENABLED=true

# NVIDIA hosted Nemotron endpoint (primary)
# Create a key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_INFERENCE_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b

# vLLM OpenAI-compatible fallback (optional self-hosted endpoint)
VLLM_BASE_URL=
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
VLLM_API_KEY=

# Role-based access control and JSON Web Tokens
JWT_SECRET=replace-with-a-long-random-secret
# Separate secret required only when ENABLE_RBAC=true. Generate both values
# independently with a cryptographically secure password generator (32+ chars).
AUTH_BOOTSTRAP_TOKEN=
ENABLE_RBAC=false

# OSRM routing for evacuation detour (public or self-hosted)
OSRM_BASE_URL=https://router.project-osrm.org

# Feature toggles
ENABLE_PREDICTION=true
ENABLE_AUDIT_CHAIN=true

# Red Hat Streams for Apache Kafka / Kafka-compatible broker
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=floodops.events
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Supabase REST persistence (optional until the integration gate is green)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HiddenLayer AI Runtime Security - Track 3: Integrating Runtime Security
# Option 1 (legacy v1): tenant-specific Interactions URL
# Use the exact Interactions API URL from your tenant; paths vary by account.
HIDDENLAYER_INTERACTIONS_URL=
HIDDENLAYER_API_KEY=
HIDDENLAYER_PROJECT=austin-floodops
# Option 2 (new v2 SDK): AITX 2026 key vendor https://aitx-key-vendor.redpond-27dfd1c6.eastus.azurecontainerapps.io/ Event Code AITX-2026
# Get client_id/client_secret valid 24h, unlocks Model Scanner, AI Runtime Security, Automated Red Teaming
HIDDENLAYER_CLIENT_ID=
HIDDENLAYER_CLIENT_SECRET=
HIDDENLAYER_HL_PROJECT_ID=default-project

# Generic first-responder CAP 1.2 webhook (optional; requires operator approval)
FIRST_RESPONDER_WEBHOOK_URL=
FIRST_RESPONDER_WEBHOOK_TOKEN=

# Optional WebEOC adapter. Use only an organization-issued sandbox endpoint and
# matching board contract. Delivery also requires approval and explicit confirmation.
WEBEOC_API_URL=
WEBEOC_USERNAME=
WEBEOC_PASSWORD=
WEBEOC_POSITION=
WEBEOC_INCIDENT=
WEBEOC_BOARD_NAME=
WEBEOC_INPUT_VIEW_NAME=

# NemoClaw/OpenShell local gateway (optional; policy is in openshell/)
OPENSHELL_GATEWAY=
